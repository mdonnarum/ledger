# Copy to .env for local runs (never commit the real .env).

# A long random string. It becomes part of your connector URL:
#   https://YOUR-HOST/<LEDGER_MCP_SECRET>/mcp
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
LEDGER_MCP_SECRET=replace-with-a-long-random-string

# The Firebase service account JSON, as a SINGLE LINE.
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the whole JSON file contents here (keep the surrounding quotes).
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"ledger-app-732df", ... }

# Port (most hosts set this automatically; default 8080).
# PORT=8080
